#!/usr/bin/env python3
"""Summarize real Ollama traffic from the journal: restarts, model loads/evictions, prompt-cache hits, prompt sizes.
usage: bin/report [SINCE]   (journalctl --since syntax; default -1d)"""
import json, pathlib, re, subprocess, sys
from collections import Counter

since = sys.argv[1] if len(sys.argv) > 1 else "-1d"
log = subprocess.run(["journalctl", "-u", "ollama", "--since", since, "-o", "cat", "--no-pager"],
                     capture_output=True, text=True, check=True).stdout.splitlines()

restarts = sum("Listening on" in l for l in log)
# Name loads by blob -> tag from the manifests; some models (qwen3.6) log general.name = n/a.
tags = {}
for mf in pathlib.Path("/home/ollama/manifests").rglob("*"):
    if mf.is_file():
        try: layers = json.loads(mf.read_text())["layers"]
        except (ValueError, KeyError, OSError): continue
        for layer in layers:
            if layer["mediaType"].endswith(".model"):
                tags.setdefault(layer["digest"].replace(":", "-"), set()).add(f"{mf.parent.name}:{mf.name}")
loads = Counter("/".join(sorted(tags.get(m.group(1), {m.group(1)[:19]}))) for l in log
                if (m := re.search(r'msg="starting llama-server".*?--model \S*/(sha256-[0-9a-f]+)', l)))
evictions = sum("evicting" in l for l in log)

sizes, hit, part, miss, total, cached, n = [], 0, 0, 0, 0, 0, None
for l in log:
    if m := re.search(r"task\.n_tokens = (\d+)", l):
        n = int(m.group(1))
    elif (m := re.search(r"prompt eval time =.*/\s*(\d+) tokens", l)) and n:
        p = int(m.group(1)); sizes.append(n); total += n; cached += n - p
        if p < 0.1 * n: hit += 1
        elif p > 0.9 * n: miss += 1
        else: part += 1
        n = None

print(f"since {since}: {restarts} restarts, {evictions} evictions")
print("model loads:", ", ".join(f"{k} x{v}" for k, v in loads.most_common()) or "none")
if sizes:
    s = sorted(sizes); q = lambda f: s[min(int(len(s) * f), len(s) - 1)]
    print(f"prompt cache: {cached / total:.0%} of prompt tokens cached ({hit} hits, {part} partial, {miss} misses)")
    print(f"prompt tokens: n={len(s)} p50={q(.5)} p90={q(.9)} p99={q(.99)} max={s[-1]}")
else:
    print("no requests")
